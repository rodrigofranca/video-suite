DATABASE_URL=postgres://ultramedia:ultramedia@localhost:5432/ultramedia?sslmode=disable
REDIS_URL=redis://localhost:6379

# S3-compatible storage (RustFS locally; any S3 provider in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ultramedia
S3_SECRET_KEY=ultramedia
S3_BUCKET=ultramedia
# Base URL the browser uses to read public HLS files
S3_PUBLIC_URL=http://localhost:9000

# Dashboard origin allowed to call the API (CORS)
DASHBOARD_ORIGIN=http://localhost:5173
# API URL used by the dashboard
PUBLIC_API_URL=http://localhost:8080

# AI worker: Whisper model (tiny, base, small, medium...) and a stable name
WHISPER_MODEL=base
AI_WORKER_NAME=ai-dev-1

# Language model gateway (LiteLLM, started by `make up`; docs/adr/0018).
# The AI worker calls it to write summaries, tags and chapters. Only the
# gateway knows the provider and its key.
LLM_BASE_URL=http://localhost:4000/v1
LLM_MODEL=ultramedia-text
# The gateway's admin key, and the key the AI worker sends to it.
LITELLM_MASTER_KEY=sk-ultramedia-dev
LLM_API_KEY=sk-ultramedia-dev
# Provider behind the gateway: OpenCode Zen (pay per use). Create a key and
# add credits in the OpenCode console (opencode.ai). OpenCode Go and the free
# models do not work here: Go is meant for coding agents, and the free models
# only work inside OpenCode.
OPENCODE_API_KEY=
OPENCODE_API_BASE=https://opencode.ai/inference/openai/v1
